{
  "$schema": "http://json-schema.org/schema#",
  "title": "Validator for misp-galaxies - Galaxies",
  "id": "https://www.github.com/MISP/misp-galaxies/schema_galaxies.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "description": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "version": {
      "type": "integer"
    },
    "name": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "uuid": {
      "type": "string"
    },
    "namespace": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "named-threat",
        "technique",
        "victim",
        "defensive",
        "detection",
        "targeting",
        "context",
        "reference"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "actor",
        "campaign",
        "malware",
        "tool",
        "attack-pattern",
        "technique",
        "tactic",
        "sector",
        "location",
        "target",
        "course-of-action",
        "control",
        "rule",
        "strategy",
        "data-source",
        "asset",
        "platform",
        "service",
        "producer",
        "organisation",
        "vulnerability",
        "reference"
      ]
    },
    "kill_chain_order": {
      "type": "object"
    }
  },
  "required": [
    "description",
    "type",
    "version",
    "name",
    "uuid"
  ]
}
